PORT=3000
NODE_ENV=development
DATA_DIR=./data
PUBLIC_DIR=./public

# API Authentication
# Generate a secure random token: openssl rand -hex 32
API_TOKEN=your-secure-token-here

# Web UI Authentication (for /trips and /login routes)
WEB_USERNAME=your-username
WEB_PASSWORD=your-password
# Generate a secure session secret: openssl rand -hex 32
SESSION_SECRET=your-session-secret-here
